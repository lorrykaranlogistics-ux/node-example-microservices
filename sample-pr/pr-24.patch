 const { normalizeAmount } = require('../../../shared/money');
 
 const validatePayment = ({ cardNumber, amount, currency }) => {
-  if (!cardNumber || String(cardNumber).length < 10) {
+  if (!cardNumber || String(cardNumber).length < 12) {
