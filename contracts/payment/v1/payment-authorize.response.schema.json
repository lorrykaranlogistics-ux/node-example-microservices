{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentAuthorizeResponseData",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "cardNumber", "amount", "currency"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^p_[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED"]
    },
    "cardNumber": {
      "type": "string",
      "minLength": 12
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "enum": ["USD", "EUR", "INR"]
    }
  }
}
