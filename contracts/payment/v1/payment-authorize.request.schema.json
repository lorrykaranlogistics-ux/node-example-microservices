{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentAuthorizeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["cardNumber", "amount", "currency"],
  "properties": {
    "cardNumber": {
      "type": "string",
      "minLength": 12
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "enum": ["USD", "EUR", "INR"]
    }
  }
}
